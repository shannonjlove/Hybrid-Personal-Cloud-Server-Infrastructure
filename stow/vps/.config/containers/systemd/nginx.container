[Unit]
Description=Nginx — Nexus VPS companion proxy
After=network-online.target tailscale.service

[Container]
Image=nginx:alpine
ContainerName=nginx
PublishPort=8080:80
PublishPort=8443:443
Volume=%E/nginx/nginx.conf:/etc/nginx/nginx.conf:ro,Z
Volume=%E/nginx/conf.d:/etc/nginx/conf.d:ro,Z
Volume=%E/nginx/certs:/etc/nginx/certs:ro,Z
AutoUpdate=registry

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
