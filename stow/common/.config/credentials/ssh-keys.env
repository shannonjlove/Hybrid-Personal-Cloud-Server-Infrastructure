# =============================================================================
# SSH Key Inventory — Shannon Love Infrastructure
# Source: ~/.config/credentials/ssh-keys.env
# Key files live at ~/.ssh/keys/<name>  (private keys never committed)
# Public keys committed in stow/common/.ssh/keys/<name>.pub
# =============================================================================

# -----------------------------------------------------------------------------
# Key Registry
# Each entry: KEY_<NAME>_PATH, KEY_<NAME>_TYPE, KEY_<NAME>_COMMENT
# -----------------------------------------------------------------------------

# Primary ed25519 key (Mac, daily use)
KEY_PRIMARY_PATH=~/.ssh/keys/id_ed25519
KEY_PRIMARY_TYPE=ed25519
KEY_PRIMARY_COMMENT=shannonjlove-primary

# Oracle Cloud key (RSA 4096, OCI requirement)
KEY_ORACLE_PATH=~/.ssh/keys/oracle_rsa_new
KEY_ORACLE_TYPE=rsa-4096
KEY_ORACLE_COMMENT=oracle_rsa_new

# Working Copy iPhone key (generated on device, public key only)
KEY_WORKINGCOPY_PATH=~/.ssh/keys/workingcopy_iphone.pub
KEY_WORKINGCOPY_TYPE=rsa-4096
KEY_WORKINGCOPY_COMMENT=WorkingCopy@iPhone-30062026
KEY_WORKINGCOPY_PUBKEY=ssh-rsa  WorkingCopy@iPhone-30062026

# Hostinger VPS deploy key
KEY_VPS_PATH=~/.ssh/keys/nexus_deploy
KEY_VPS_TYPE=ed25519
KEY_VPS_COMMENT=nexus-deploy

# -----------------------------------------------------------------------------
# Key Passphrases (leave blank if key has no passphrase)
# -----------------------------------------------------------------------------
KEY_PRIMARY_PASSPHRASE=
KEY_ORACLE_PASSPHRASE=
KEY_VPS_PASSPHRASE=
