# =============================================================================
# Shared Environment — Shannon Love Infrastructure
# LIVE FILE: ~/.config/ai-keys/shared.env
# =============================================================================
# This file sources all credential category files.
# Fill values in the individual files under ~/.config/credentials/
# then run: source ~/.config/ai-keys/shared.env
# =============================================================================

CREDENTIALS_DIR="${HOME}/.config/credentials"

# shellcheck source=/dev/null
[ -f "${CREDENTIALS_DIR}/api-tokens.env"    ] && source "${CREDENTIALS_DIR}/api-tokens.env"
[ -f "${CREDENTIALS_DIR}/ssh-keys.env"      ] && source "${CREDENTIALS_DIR}/ssh-keys.env"
[ -f "${CREDENTIALS_DIR}/browser-logins.env"] && source "${CREDENTIALS_DIR}/browser-logins.env"
[ -f "${CREDENTIALS_DIR}/apps.env"          ] && source "${CREDENTIALS_DIR}/apps.env"
