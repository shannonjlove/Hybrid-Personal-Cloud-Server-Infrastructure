# =============================================================================
# SSH Config — Shannon Love Infrastructure
# All connections route through Tailscale mesh (no port forwarding needed)
# =============================================================================

# Hostinger VPS — Nexus (primary container host)
Host nexus vps
    HostName nexus.shannonjlove.cloud
    User root
    IdentityFile ~/.ssh/id_ed25519

# Oracle Cloud — sOs (ARM secondary)
Host sos oracle
    HostName 100.67.229.94
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519

# WebTop desktop container
Host webtop
    HostName webtop
    User user
    IdentityFile ~/.ssh/id_ed25519

# iPhone (Working Copy git operations via Tailscale)
Host iphone
    HostName shajes-iphone
    User mobile
    IdentityFile ~/.ssh/id_ed25519

# Wildcard: prefer Tailscale for all shannonjlove.cloud hosts
Host *.shannonjlove.cloud
    User root
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
