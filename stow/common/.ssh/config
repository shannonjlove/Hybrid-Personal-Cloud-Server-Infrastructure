# =============================================================================
# SSH Config — Shannon Love Infrastructure
# Tailnet: tail179603.ts.net  |  MagicDNS + HTTPS certs enabled
# All connections route through Tailscale mesh
# =============================================================================

# Hostinger VPS — Nexus (primary container host)
Host nexus vps
    HostName nexus.tail179603.ts.net
    User root
    IdentityFile ~/.ssh/id_ed25519

# Oracle Cloud — sOs (ARM secondary)
Host sos oracle
    HostName sos.tail179603.ts.net
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519

# WebTop desktop container
Host webtop
    HostName webtop.tail179603.ts.net
    User user
    IdentityFile ~/.ssh/id_ed25519

# iPhone (Working Copy git operations via Tailscale)
Host iphone
    HostName shajes-iphone.tail179603.ts.net
    User mobile
    IdentityFile ~/.ssh/id_ed25519

# Wildcard: any tailnet host
Host *.tail179603.ts.net
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3

# Public-facing domain (fallback to direct)
Host *.shannonjlove.cloud
    User root
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
