[Unit]
Description=ai-memory HTTP Daemon — cross-agent memory (Nexus)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/ai-memory:latest
ContainerName=ai-memory
Volume=/opt/ai-memory/data:/data:Z
Environment=AI_MEMORY_DB=/data/ai-memory.db
PublishPort=127.0.0.1:9077:9077
# Nginx Proxy Manager routes memory.shannonjlove.cloud → 127.0.0.1:9077
# Configure the proxy host manually in the NPM web UI with SSL enabled.

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
