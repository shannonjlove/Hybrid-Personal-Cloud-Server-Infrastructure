[Unit]
Description=ai-memory HTTP Daemon — cross-agent memory (Oracle sOs, ARM64)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/ai-memory:latest
ContainerName=ai-memory
Volume=/opt/ai-memory/data:/data:Z
Environment=AI_MEMORY_DB=/data/ai-memory.db
PublishPort=127.0.0.1:9077:9077
# Accessible via Tailscale only on sOs — no public proxy on this node.

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
