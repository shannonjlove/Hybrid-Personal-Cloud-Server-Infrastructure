# OCI CLI configuration template
# Copy to /opt/mcp-server-oci/.oci/config and fill in your values
# Never commit the populated file to this repository

[DEFAULT]
user=ocid1.user.oc1..<REPLACE_WITH_USER_OCID>
fingerprint=<REPLACE_WITH_KEY_FINGERPRINT>
tenancy=ocid1.tenancy.oc1..<REPLACE_WITH_TENANCY_OCID>
region=us-ashburn-1
key_file=/opt/mcp-server-oci/.oci/oci_api_key.pem

# Add additional profiles below for multi-tenancy setups
# [PROFILE_NAME]
# user=...
# fingerprint=...
# tenancy=...
# region=...
# key_file=...
