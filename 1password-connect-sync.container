[Unit]
Description=1Password Connect Sync
After=network-online.target 1password-connect-api.service
Wants=network-online.target
BindsTo=1password-connect-api.service

[Container]
Image=1password/connect-sync:latest
PublishPort=8081:8080
Volume=/opt/1password/1password-credentials.json:/home/opuser/.op/1password-credentials.json:ro
Volume=/opt/1password/data:/home/opuser/.op/data:Z
Environment=OP_LOG_LEVEL=debug

[Service]
Restart=on-failure
RestartSec=5s
Type=notify
NotifyAccess=main

[Install]
WantedBy=multi-user.target default.target
