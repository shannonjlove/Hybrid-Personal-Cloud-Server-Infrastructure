[Unit]
Description=1Password Connect API
After=network-online.target
Wants=network-online.target

[Container]
Image=1password/connect-api:latest
PublishPort=8080:8080
Volume=/opt/1password/1password-credentials.json:/home/opuser/.op/1password-credentials.json:ro
Volume=/opt/1password/data:/home/opuser/.op/data:Z
Environment=OP_LOG_LEVEL=debug

[Service]
Restart=on-failure
RestartSec=5s
Type=notify
NotifyAccess=main

[Install]
WantedBy=multi-user.target default.target
