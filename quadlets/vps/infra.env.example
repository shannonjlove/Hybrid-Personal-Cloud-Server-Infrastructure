# VPS environment file — copy to /etc/containers/systemd/infra.env on Nexus
# and fill in real values. Never commit real credentials.

# Bookstack
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASS=CHANGE_ME
BOOKSTACK_DB_ROOT_PASS=CHANGE_ME

# Photoprism
PHOTOPRISM_ADMIN_PASS=CHANGE_ME

# memlord
MEMLORD_DB_PASS=CHANGE_ME
MEMLORD_JWT_SECRET=CHANGE_ME

# WebTop
TZ=America/Chicago
# Generate with: htpasswd -nb username password
WEBTOP_BASIC_AUTH=shannon:$$apr1$$CHANGE_ME
