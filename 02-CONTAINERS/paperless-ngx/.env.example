# =============================================================================
# Paperless-NGX environment — used by ALL quadlet containers via EnvironmentFile
# Deploy to: /etc/paperless/paperless.env  (chmod 640, chown root:root)
# Never commit a populated copy of this file to git.
# =============================================================================

# ── PostgreSQL (paperless-db container) ───────────────────────────────────────
# These must match the PAPERLESS_DB* values below.
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Paperless core ────────────────────────────────────────────────────────────
PAPERLESS_REDIS=redis://paperless-broker:6379
PAPERLESS_DBHOST=paperless-db
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=CHANGE_ME_strong_db_password   # must equal POSTGRES_PASSWORD above

# Django secret key — generate with: openssl rand -hex 50
PAPERLESS_SECRET_KEY=CHANGE_ME_long_random_secret_key

# ── Site ──────────────────────────────────────────────────────────────────────
PAPERLESS_URL=https://paperless.shannonjlove.cloud
PAPERLESS_SITE_TITLE=Shannon's Archive
PAPERLESS_ALLOWED_HOSTS=paperless.shannonjlove.cloud
PAPERLESS_CORS_ALLOWED_HOSTS=https://paperless.shannonjlove.cloud

# ── Tika / Gotenberg ──────────────────────────────────────────────────────────
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_ENDPOINT=http://paperless-tika:9998
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://paperless-gotenberg:3000

# ── Storage (PARA-aligned path template) ─────────────────────────────────────
# Result: 2026/area-legal/IRS/tax-return-2025.pdf
PAPERLESS_FILENAME_FORMAT={created_year}/{tag_list}/{correspondent}/{title}
PAPERLESS_FILENAME_FORMAT_REMOVE_NONE=true

# ── OCR ───────────────────────────────────────────────────────────────────────
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=eng
PAPERLESS_OCR_MODE=skip_noarchival

# ── Consumer ─────────────────────────────────────────────────────────────────
PAPERLESS_CONSUMER_POLLING=60
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
PAPERLESS_CONSUMER_ENABLE_ASN_BARCODE=true
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true

# ── Performance (tuned for KVM 4 — 4 CPU / 16 GB RAM) ────────────────────────
PAPERLESS_TASK_WORKERS=2
PAPERLESS_THREADS_PER_WORKER=2
PAPERLESS_WEBSERVER_WORKERS=2

# ── Timezone ──────────────────────────────────────────────────────────────────
PAPERLESS_TIME_ZONE=America/Chicago

# ── User mapping (match host UID/GID that owns /opt/paperless) ───────────────
# Run `id -u && id -g` on the VPS to get these values
USERMAP_UID=1000
USERMAP_GID=1000

# ── First-run admin (used by create-superuser.sh) ────────────────────────────
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_MAIL=sjlove@shannonjeffreylove.com
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── API token (set after first login: Settings → API Token in web UI) ─────────
# Used by seed-para-tags.sh and the iOS Scriptable client
PAPERLESS_API_TOKEN=
