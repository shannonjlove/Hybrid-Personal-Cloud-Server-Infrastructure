# Podman Quadlet — Apache Tika content extraction
# Install to: /etc/containers/systemd/paperless-tika.container
# Manages:    paperless-tika.service

[Unit]
Description=Paperless Tika (content extraction)
After=network-online.target paperless-network.service
Requires=paperless-network.service

[Container]
Image=ghcr.io/paperless-ngx/tika:latest
ContainerName=paperless-tika
Network=paperless.network
HealthCmd=curl -sf http://localhost:9998/tika
HealthInterval=30s
HealthRetries=3
HealthTimeout=15s
Label=app=paperless

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
