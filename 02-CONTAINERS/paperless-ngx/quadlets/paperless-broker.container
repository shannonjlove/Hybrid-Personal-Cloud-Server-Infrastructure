# Podman Quadlet — Valkey task broker
# Install to: /etc/containers/systemd/paperless-broker.container
# Manages:    paperless-broker.service

[Unit]
Description=Paperless Broker (Valkey 8)
After=network-online.target paperless-network.service
Requires=paperless-network.service

[Container]
Image=docker.io/valkey/valkey:8
ContainerName=paperless-broker
Network=paperless.network
Volume=paperless-broker-data.volume:/data:Z
HealthCmd=valkey-cli ping
HealthInterval=30s
HealthRetries=3
HealthTimeout=5s
Label=app=paperless

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target default.target
