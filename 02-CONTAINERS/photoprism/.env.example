# PhotoPrism environment — deploy to /etc/photoprism/photoprism.env (chmod 640)

PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=CHANGE_ME_admin_password
PHOTOPRISM_SITE_URL=https://photos.shannonjlove.cloud
PHOTOPRISM_ORIGINALS_LIMIT=10000
PHOTOPRISM_HTTP_COMPRESSION=gzip
PHOTOPRISM_WORKERS=2
PHOTOPRISM_READONLY=false
TZ=America/Los_Angeles
