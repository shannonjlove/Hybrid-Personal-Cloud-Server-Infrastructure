{
  "_comment": "MCP config for Claude Code / Claude Desktop on all server targets. Copy to ~/.claude/claude_desktop_config.json and fill in YOUR_MEMSTATE_API_KEY_HERE.",
  "mcpServers": {
    "memlord": {
      "url": "https://memory.shannonjlove.cloud/mcp"
    },
    "memstate": {
      "command": "npx",
      "args": ["-y", "@memstate/mcp"],
      "env": {
        "MEMSTATE_API_KEY": "YOUR_MEMSTATE_API_KEY_HERE"
      }
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "mediaProcessor": {
      "command": "npx",
      "args": ["-y", "mcp-media-processor@latest"]
    },
    "mcp-server-oci": {
      "command": "uv",
      "args": ["--directory", "/opt/mcp-server-oci", "run", "python", "-m", "mcp_server_oci.mcp_server"],
      "env": {
        "FASTMCP_LOG_LEVEL": "INFO"
      }
    }
  }
}
