{
  "mcpServers": {
    "memlord": {
      "url": "https://memory.shannonjlove.cloud/mcp"
    },
    "memstate": {
      "command": "npx",
      "args": ["-y", "@memstate/mcp"],
      "env": {
        "MEMSTATE_API_KEY": "YOUR_MEMSTATE_API_KEY_HERE"
      }
    },
    "ollama": {
      "command": "uvx",
      "args": ["mcp-ollama"],
      "env": {
        "OLLAMA_HOST": "http://ollama:11434"
      }
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    }
  }
}
