{
  "mcpServers": {
    "memlord": {
      "url": "https://memory.shannonjlove.cloud/mcp"
    },
    "memstate": {
      "command": "npx",
      "args": ["-y", "@memstate/mcp"],
      "env": {
        "MEMSTATE_API_KEY": "YOUR_MEMSTATE_API_KEY_HERE"
      }
    },
    "ollama": {
      "command": "uvx",
      "args": ["mcp-ollama"],
      "env": {
        "OLLAMA_HOST": "http://ollama:11434"
      }
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "mediaProcessor": {
      "command": "npx",
      "args": ["-y", "mcp-media-processor@latest"]
    },
    "mcp-server-oci": {
      "command": "/config/.local/bin/uv",
      "args": ["--directory", "/config/mcp-server-oci", "run", "python", "-m", "mcp_server_oci.mcp_server"],
      "env": {
        "HOME": "/config",
        "FASTMCP_LOG_LEVEL": "INFO"
      }
    }
  }
}
