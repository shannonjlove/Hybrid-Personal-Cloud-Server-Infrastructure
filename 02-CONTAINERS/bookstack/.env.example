# BookStack environment — deploy to /etc/bookstack/bookstack.env (chmod 640)

# MariaDB (used by bookstack-db container)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=bookstack
MYSQL_USER=bookstack
MYSQL_PASSWORD=CHANGE_ME_db_password

# BookStack app (used by bookstack container)
APP_URL=https://docs.shannonjlove.cloud
DB_HOST=bookstack-db
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=CHANGE_ME_db_password   # must equal MYSQL_PASSWORD above

# linuxserver.io image settings
PUID=1000
PGID=1000
TZ=America/Los_Angeles
