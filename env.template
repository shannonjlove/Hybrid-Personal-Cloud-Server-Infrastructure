# =============================================================================
# .env.template — copy to .env and fill in real values
# .env is gitignored and never committed
# Place this file on each node at the repo root before running deploy scripts
# =============================================================================

# ---------------------------------------------------------------------------
# Nginx Proxy Manager
# ---------------------------------------------------------------------------
NPM_URL=http://shannonjlove.tail179603.ts.net:81
NPM_EMAIL=shannonjlove@mac.com
NPM_PASSWORD=your-npm-password-here
# Public subdomain NPM uses to proxy its own admin UI
NPM_DOMAIN=npm.shannonjlove.cloud

# ---------------------------------------------------------------------------
# Anthropic API (required for memory-agent on Nexus)
# The deploy script stores this as a Podman secret — never written to disk in plaintext.
# Only needed on Nexus for deploy-memory-agent-nexus.sh.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---------------------------------------------------------------------------
# Shared context / Memory services
# ---------------------------------------------------------------------------
# MEMORY_ROOT is set automatically by deploy-shared-context-nexus.sh and
# deploy-shared-context-sos-webtop.sh to /mnt/shared-context/claude-memories.
# Override here only if you want a non-default location.
# MEMORY_ROOT=/mnt/shared-context/claude-memories

# ---------------------------------------------------------------------------
# Hostinger API
# ---------------------------------------------------------------------------
HOSTINGER_API_TOKEN=your-hostinger-api-token-here
HOSTINGER_CLAUDE_TOKEN=your-claude-hostinger-api-token-here

# ---------------------------------------------------------------------------
# BookStack
# ---------------------------------------------------------------------------
# BOOKSTACK_DB_NAME=
# BOOKSTACK_DB_USER=
# BOOKSTACK_DB_PASS=
# BOOKSTACK_DB_ROOT_PASS=

# ---------------------------------------------------------------------------
# PhotoPrism
# ---------------------------------------------------------------------------
# PHOTOPRISM_ADMIN_PASS=
